  <version>0.0.0</version>
  <description>Simulador em lote de drones EVTOL com FSM e nó substituto PX4</description>
  <maintainer email="jpancar2004@gmail.com">joao</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>px4_msgs</depend>
